<Window x:Class="DailyCheck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DailyCheck"
        Title="每日打卡"
        Height="840" Width="540"
        MinHeight="560" MinWidth="470"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FA"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ==================== 倒数日 ==================== -->
    <Border Grid.Row="0" Background="#2B3A55" Padding="20,13,20,15">
      <StackPanel>
        <TextBlock Text="倒数日" Foreground="#8FA3C4" FontSize="11" Margin="0,0,0,4"/>
        <ItemsControl x:Name="CountdownList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" Foreground="White"
                             FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding TargetDate, StringFormat={}{0:yyyy年MM月dd日}}"
                             Foreground="#8FA3C4" FontSize="11" Margin="0,1,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding DaysLeftText}"
                           Foreground="#FFD166" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="NoCountdownHint"
                   Text="还没有设置倒数日 —— 点下方「倒数日」按钮添加"
                   Foreground="#6B7C99" FontSize="12"/>
      </StackPanel>
    </Border>

    <!-- ==================== 四层目标 ==================== -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,4,0,8">
      <StackPanel>

        <!-- 总目标 -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="🎯 总目标" FontSize="11.5" FontWeight="SemiBold"
                       Foreground="#9B8AD9" Margin="0,0,0,5"/>
            <local:GoalView x:Name="OverallView" Accent="#7C5CFC"/>
          </StackPanel>
        </Border>

        <!-- 本月 -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock x:Name="MonthHeader" Text="📅 本月" FontSize="11.5" FontWeight="SemiBold"
                       Foreground="#7FAEF8" Margin="0,0,0,5"/>
            <local:GoalView x:Name="MonthView" Accent="#4F8EF7"/>
          </StackPanel>
        </Border>

        <!-- 本周 -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock x:Name="WeekHeader" Text="🗓 本周" FontSize="11.5" FontWeight="SemiBold"
                       Foreground="#5FBF95" Margin="0,0,0,5"/>
            <local:GoalView x:Name="WeekView" Accent="#22A06B"/>
          </StackPanel>
        </Border>

        <!-- 今天 -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock x:Name="DayHeader" Text="☀ 今天" FontSize="11.5" FontWeight="SemiBold"
                       Foreground="#EFA05F" Margin="0,0,0,5"/>
            <local:GoalView x:Name="DayView" Accent="#E8833A"/>

            <!-- 今日必做：从上层目标继承下来的每日任务 -->
            <Border Background="#FFFBEF" BorderBrush="#F3E3B8" BorderThickness="1"
                    CornerRadius="8" Padding="12,10" Margin="0,13,0,0">
              <StackPanel>
                <TextBlock Text="📌 今日必做（上层目标里的「每日」任务）"
                           FontSize="11.5" FontWeight="SemiBold" Foreground="#A9761A"/>
                <TextBlock x:Name="NoDailyHint"
                           Text="还没有每日任务。在任意目标下点「＋ 每日」就能加，比如「背 50 个单词」。"
                           Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <ItemsControl x:Name="DailyList" Margin="0,6,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,2.5">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Content="{Binding Text}" IsChecked="{Binding Checked, Mode=TwoWay}"
                                  VerticalContentAlignment="Center" Click="Daily_Click"/>
                        <TextBlock Grid.Column="1" Text="{Binding DailyCountText}"
                                   Style="{StaticResource HintText}"
                                   VerticalAlignment="Center" Margin="9,0,0,0"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- ==================== 底部操作栏 ==================== -->
    <Border Grid.Row="2" Background="White" Padding="14,9"
            BorderBrush="#E4E9F2" BorderThickness="0,1,0,0">
      <Grid>
        <StackPanel Orientation="Horizontal">
          <Button Content="倒数日" Click="EditCountdown_Click" Style="{StaticResource FlatButton}"/>
          <Button Content="AI 分析" Click="Ai_Click" Style="{StaticResource FlatButton}" Margin="8,0,0,0"/>
          <Button Content="数据目录" Click="OpenDataFolder_Click" Style="{StaticResource FlatButton}" Margin="8,0,0,0"/>
        </StackPanel>
        <CheckBox x:Name="AutoStartCheck" Content="开机自启" HorizontalAlignment="Right"
                  VerticalAlignment="Center" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/>
      </Grid>
    </Border>
  </Grid>
</Window>
