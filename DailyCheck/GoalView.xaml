<UserControl x:Class="DailyCheck.GoalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DailyCheck"
             x:Name="Root">

  <StackPanel>

    <!-- 标题行：可就地改文字 -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBox Grid.Column="0"
               Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               BorderThickness="0" Background="Transparent"
               FontSize="14" FontWeight="SemiBold" Padding="0" Margin="0"
               Foreground="{Binding Accent, ElementName=Root}"
               VerticalContentAlignment="Center"
               ToolTip="点这里可以直接改目标文字"/>

      <TextBlock Grid.Column="1" Text="{Binding PercentText}" FontSize="15" FontWeight="Bold"
                 Foreground="{Binding Accent, ElementName=Root}"
                 VerticalAlignment="Center" Margin="10,0,0,0"/>

      <Button Grid.Column="2" Content="✕" Click="Delete_Click"
              Style="{StaticResource IconButton}" Margin="7,0,0,0"
              ToolTip="删除这个子目标"/>
    </Grid>

    <!-- 进度条 -->
    <ProgressBar Value="{Binding Percent}" Maximum="100"
                 Style="{StaticResource RoundedProgress}"
                 Foreground="{Binding Accent, ElementName=Root}"
                 Margin="0,8,0,0"/>

    <!-- 完成情况小字 -->
    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource HintText}" Margin="0,5,0,0"/>

    <!-- 任务清单 -->
    <ItemsControl ItemsSource="{Binding Tasks}" Margin="0,7,0,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid Margin="0,2.5">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <CheckBox Content="{Binding Text}" IsChecked="{Binding Checked, Mode=TwoWay}"
                      VerticalContentAlignment="Center" Click="Task_Click"/>

            <Border Grid.Column="1" Background="#FFF3D4" CornerRadius="4" Padding="5,1"
                    Margin="7,0,0,0" VerticalAlignment="Center"
                    ToolTip="每日任务：每天重新打卡，没打卡的天算未完成"
                    Visibility="{Binding Daily, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="每日" FontSize="10" Foreground="#A9761A"/>
            </Border>

            <Button Grid.Column="2" Content="✕" Click="DeleteTask_Click"
                    Style="{StaticResource IconButton}" Margin="5,0,0,0"/>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- 子目标：递归自己，左边一条竖线表示层级 -->
    <ItemsControl ItemsSource="{Binding Children}" Margin="0,3,0,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border BorderBrush="#DCE4F0" BorderThickness="2,0,0,0" Padding="11,0,0,0" Margin="0,7,0,0">
            <local:GoalView Accent="{Binding Accent, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- 本层操作 -->
    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
      <Button Content="＋ 任务" Click="AddTask_Click" Style="{StaticResource MiniButton}"/>
      <Button Content="＋ 每日" Click="AddDaily_Click" Style="{StaticResource MiniButton}"
              Margin="6,0,0,0" ToolTip="每天都要做的事，比如「背 50 个单词」"/>
      <Button Content="＋ 子目标" Click="AddChild_Click" Style="{StaticResource MiniButton}"
              Margin="6,0,0,0"/>
    </StackPanel>

  </StackPanel>
</UserControl>
