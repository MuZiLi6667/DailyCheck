<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============ 配色 ============ -->
  <!-- 主蓝 #4F8EF7 / 月紫 #7C5CFC / 周绿 #22A06B / 深蓝 #2B3A55 -->

  <!-- ============ 卡片 ============ -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="White"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="16,13,16,15"/>
    <Setter Property="Margin" Value="14,6"/>
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="12" ShadowDepth="1" Direction="270"
                          Color="#3A4A66" Opacity="0.10"/>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ 圆角进度条 ============ -->
  <Style x:Key="RoundedProgress" TargetType="ProgressBar">
    <Setter Property="Height" Value="10"/>
    <Setter Property="Maximum" Value="100"/>
    <Setter Property="Background" Value="#E9EEF6"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Border CornerRadius="5" Background="{TemplateBinding Background}">
            <Grid x:Name="PART_Track">
              <Border x:Name="PART_Indicator" CornerRadius="5"
                      Background="{TemplateBinding Foreground}"
                      HorizontalAlignment="Left"/>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ 普通按钮 ============ -->
  <Style x:Key="FlatButton" TargetType="Button">
    <Setter Property="Padding" Value="13,6"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Background" Value="#EEF3FB"/>
    <Setter Property="Foreground" Value="#3A5A8C"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#DCE7F8"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#C7D8F1"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 主按钮（实心蓝） -->
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
    <Setter Property="Background" Value="#4F8EF7"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Padding" Value="16,6"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#3D7BE8"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#2F68CE"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 小图标按钮（删除用） -->
  <Style x:Key="IconButton" TargetType="Button">
    <Setter Property="Width" Value="22"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#B8C2D4"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="11" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#FDE8E8"/>
              <Setter Property="Foreground" Value="#E5484D"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ 输入框 ============ -->
  <Style x:Key="InputBox" TargetType="TextBox">
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="#25324A"/>
    <Setter Property="CaretBrush" Value="#4F8EF7"/>
    <Setter Property="Background" Value="#FBFCFE"/>
    <Setter Property="BorderBrush" Value="#DDE4EF"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" CornerRadius="6"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="#4F8EF7"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ 复选框（全局默认） ============ -->
  <Style TargetType="CheckBox">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="#25324A"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>

  <!-- 小号按钮（目标节点里的「＋ 任务」等） -->
  <Style x:Key="MiniButton" TargetType="Button">
    <Setter Property="Padding" Value="9,4"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Background" Value="#EEF3FB"/>
    <Setter Property="Foreground" Value="#5A7099"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="5" Background="{TemplateBinding Background}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#DCE7F8"/>
              <Setter Property="Foreground" Value="#3A5A8C"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <BooleanToVisibilityConverter x:Key="BoolToVis"/>

  <!-- ============ 通用文字 ============ -->
  <Style x:Key="HintText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Foreground" Value="#8894A8"/>
  </Style>

  <Style x:Key="GoalText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="#25324A"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

</ResourceDictionary>
