<Window x:Class="DailyCheck.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="倒数日" Height="520" Width="470"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6FA"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        ShowInTaskbar="False">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Margin="20,18,20,0" TextWrapping="Wrap"
               Style="{StaticResource HintText}"
               Text="设置重要日期，程序会自动算出还剩多少天。「每年重复」适合生日、纪念日。"/>

    <ScrollViewer Grid.Row="1" Margin="20,14,20,0" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="CdList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="#F8FAFD" CornerRadius="8" Padding="10"
                    Margin="0,0,0,8" BorderBrush="#E8EEF7" BorderThickness="1">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="✕" Click="DelCd_Click"
                        Style="{StaticResource IconButton}" ToolTip="删除"/>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,9,0,0">
                  <DatePicker SelectedDate="{Binding TargetDate, Mode=TwoWay}" Width="155"/>
                  <CheckBox Content="每年重复" IsChecked="{Binding Yearly, Mode=TwoWay}"
                            Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.Row="2" Background="White" Padding="14,10" Margin="0,14,0,0"
            BorderBrush="#E4E9F2" BorderThickness="0,1,0,0">
      <Grid>
        <Button Content="＋ 添加倒数日" Click="AddCd_Click"
                Style="{StaticResource FlatButton}" HorizontalAlignment="Left"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="取消" Click="Cancel_Click" Style="{StaticResource FlatButton}"/>
          <Button Content="保存" Click="Ok_Click" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
